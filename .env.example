# docker-compose.yml overrides. Copy to .env (gitignored) and change every password before deploying.

# Postgres (the `db` service).
APP_DB_PASSWORD=Careflow@2026

# OpenEMR's own MariaDB.
OPENEMR_DB_ROOT_PASSWORD=Careflow@2026
OPENEMR_DB_PASSWORD=Careflow@2026

# OpenEMR admin UI login; only applies on a fresh install (Administration -> Users to change after).
OPENEMR_ADMIN_PASSWORD=Careflow@2026

# Keycloak's own Postgres database.
KEYCLOAK_DB_PASSWORD=Careflow@2026

# Keycloak admin console login.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=Careflow@2026
