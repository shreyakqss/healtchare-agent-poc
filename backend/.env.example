# Password is URL-encoded (@ -> %40); matches APP_DB_PASSWORD in the root .env.example.
DATABASE_URL=postgresql://postgres:Careflow%402026@localhost:5435/healthcare_agent
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SESSION_SECRET=
# Local HTTP requires false; production HTTPS requires true.
AUTH_COOKIE_SECURE=False
# Service account that creates Keycloak logins for self-registering patients. Copy the secret from
# Keycloak: careflow realm -> Clients -> careflow-admin -> Credentials. Unset = self-register returns 500.
KEYCLOAK_ADMIN_CLIENT_ID=careflow-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# OpenEMR OAuth client and service account.
OPENEMR_CLIENT_ID=
OPENEMR_CLIENT_SECRET=
OPENEMR_USERNAME=
OPENEMR_PASSWORD=

# OPENAI_API_KEY=
# Model for every agent. Set LLM_SUPPORTS_EFFORT=true only for a reasoning model (gpt-5*, o-series).
LLM_MODEL=gpt-4.1-mini
LLM_SUPPORTS_EFFORT=false
# TAVILY_API_KEY=

# Agent tracing

# Self-hosted: docker compose --profile tracing up -d, then keys from Settings -> API Keys.

# LANGFUSE_HOST=http://localhost:2000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
