APP_NAME=Healthcare Agent POC
APP_VERSION=0.1.0
DEBUG=True

HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_agent

# Local LLM. Run `ollama serve` and `ollama pull llama3.1:8b` on the host.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=120

# Synthetic medical documents and images only. No real PHI.
MAX_UPLOAD_MB=25
