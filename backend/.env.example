APP_NAME=Healthcare Agent POC
APP_VERSION=0.1.0
DEBUG=True

HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_agent

# ---- llm -----------------------------------------------------------------
# Hosted OpenAI. Everything goes through services/llm_client.py, which speaks
# the chat-completions API over httpx — no provider SDK is installed.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-nano
LLM_TIMEOUT_SECONDS=120

# Reasoning models (gpt-5.x) accept `reasoning_effort` and reject
# `temperature`; older chat models are the other way round. Set this to match
# the model above, or the provider 400s on an unknown field.
LLM_SUPPORTS_EFFORT=True
LLM_EFFORT=low

OPENAI_API_KEY=

# Synthetic medical documents and images only. No real PHI.
MAX_UPLOAD_MB=25
